<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!-- Historico de versiones (sin imagen) de la portada y de las paginas. Texto NULL en la portada. -->
    <changeSet id="024-create-story-page-version" author="storyteller">
        <createTable tableName="story_page_version">
            <column name="id" type="BIGINT"><constraints primaryKey="true" nullable="false"/></column>
            <column name="story_page_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="text" type="VARCHAR(500)"/>
            <column name="scene_compose" type="jsonb"/>
            <column name="length_warning" type="VARCHAR(20)"><constraints nullable="false"/></column>
            <column name="is_current" type="BOOLEAN"><constraints nullable="false"/></column>
            <column name="created_at" type="TIMESTAMPTZ"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMPTZ"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="story_page_version" baseColumnNames="story_page_id" constraintName="fk_story_page_version_page" referencedTableName="story_page" referencedColumnNames="id" onDelete="CASCADE"/>
    </changeSet>

    <!-- Como mucho una version vigente por pagina. -->
    <changeSet id="024-add-story-page-version-current-unique-index" author="storyteller">
        <sql>CREATE UNIQUE INDEX ux_story_page_version_current ON story_page_version (story_page_id) WHERE is_current</sql>
    </changeSet>
</databaseChangeLog>
