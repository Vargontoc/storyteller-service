<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">


        <changeSet id="004_create_character" author="vargontoc">
            <createTable tableName="character">
                <column name="id" type="BIGINT">
                    <constraints nullable="false" primaryKey="true" />
                </column>
                <column name="name" type="VARCHAR(20)">
                    <constraints nullable="false" />
                </column>
                <column name="story_id" type="BIGINT">
                    <constraints nullable="false" />
                </column>
                <column name="visual_description" type="VARCHAR(1000)">
                    <constraints nullable="false"  />
                </column>
                <column name="narrative_description" type="VARCHAR(1000)">
                    <constraints nullable="false" />
                </column>
                <column name="created_at" type="TIMESTAMPTZ">
                    <constraints nullable="false"/>
                </column>
                <column name="updated_at" type="TIMESTAMPTZ"/>
            </createTable>

            <addForeignKeyConstraint baseTableName="character" baseColumnNames="story_id" constraintName="FK_story_character" referencedTableName="story" referencedColumnNames="id" />
        </changeSet>
</databaseChangeLog>