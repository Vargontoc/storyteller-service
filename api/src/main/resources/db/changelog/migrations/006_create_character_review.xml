<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="006_create_character_review" author="vargontoc">
        <createTable tableName="character_review">
            <column name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" />
            </column>
            <column name="character_id" type="BIGINT">
                <constraints nullable="false" />
            </column>
            <column name="hint" type="VARCHAR(500)">
                <constraints nullable="false" />
            </column>
            <column name="hint_accepted" type="boolean">
                <constraints nullable="false" />
            </column>
            <column name="rejected_reason" type="VARCHAR(500)"></column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false" />
            </column>
            <column name="target" type="VARCHAR(15)">
                <constraints nullable="false" />
            </column>
            <column name="candidate_narrative" type="VARCHAR(1000)">
            </column>
            <column name="candidate_visual" type="VARCHAR(1000)">
            </column>
            <column name="created_at" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="character_review" baseColumnNames="character_id" constraintName="FK_character_character_review" referencedTableName="character" referencedColumnNames="id" />
    </changeSet>

</databaseChangeLog>