<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">
    
    <changeSet id="011_new_fields_to_pages" author="vargontoc">

        <dropColumn tableName="story_page">
            <column name="is_cover"></column>
        </dropColumn>

        <dropColumn tableName="story_page">
            <column name="is_last_page"></column>
        </dropColumn>

        <dropColumn tableName="story_page">
            <column name="scene_prompt"></column>
        </dropColumn>

        <addColumn tableName="story_page">
            <column name="scene_compose" type="jsonb" ></column>
        </addColumn>

        <dropColumn tableName="story_page_review">
            <column name="candidate_prompt_scene"></column>
        </dropColumn>

        <addColumn tableName="story_page_review">
            <column name="scene_compose" type="jsonb" ></column>
        </addColumn>

    </changeSet>
</databaseChangeLog>