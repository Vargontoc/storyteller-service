<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="007_create_story_review_character_draft" author="vargontoc">
        <createTable tableName="story_review_character_draft">
            <column name="review_id" type="BIGINT">
                <constraints nullable="false" />
            </column>
            <column name="name" type="VARCHAR(20)"/>
            <column name="narrative_description" type="VARCHAR(1000)"/>
            <column name="visual_description" type="VARCHAR(1000)"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="story_review_character_draft" baseColumnNames="review_id" constraintName="FK_story_review_character_draft" referencedTableName="story_review" referencedColumnNames="id" />
    </changeSet>

</databaseChangeLog>
