<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">


        <changeSet id="008_create_story_page" author="vargontoc">
            <createTable tableName="story_page">
                <column name="id" type="BIGINT">
                    <constraints nullable="false" primaryKey="true" />
                </column>
                <column name="story_id" type="BIGINT">
                    <constraints nullable="false" />
                </column>
                <column name="page" type="INT">
                    <constraints nullable="false" />
                </column>
                <column name="is_cover" type="boolean">
                    <constraints nullable="false" />
                </column>
                <column name="is_last_page" type="boolean">
                    <constraints nullable="false" />
                </column>
                <column name="text" type="VARCHAR(500)">
                    <constraints nullable="false"  />
                </column>
                <column name="scene_prompt" type="VARCHAR(2000)">
                    <constraints nullable="false" />
                </column>
                <column name="image_asset" type="TEXT" />
                <column name="audio_asset" type="TEXT" />
                <column name="created_at" type="TIMESTAMPTZ">
                    <constraints nullable="false"/>
                </column>
                <column name="updated_at" type="TIMESTAMPTZ"/>
            </createTable>

            <addForeignKeyConstraint baseTableName="story_page" baseColumnNames="story_id" constraintName="FK_story_story_page" referencedTableName="story" referencedColumnNames="id" />
        </changeSet>
</databaseChangeLog>