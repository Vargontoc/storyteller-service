<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!-- Voces subidas por el usuario: nombre unico, idioma y declaracion de permiso. Sin vinculo con narraciones. -->
    <changeSet id="026-create-voice" author="storyteller">
        <createTable tableName="voice">
            <column name="id" type="BIGINT"><constraints primaryKey="true" nullable="false"/></column>
            <column name="name" type="VARCHAR(100)"><constraints nullable="false"/></column>
            <column name="language" type="VARCHAR(10)"><constraints nullable="false"/></column>
            <column name="permission_declared" type="BOOLEAN"><constraints nullable="false"/></column>
            <column name="created_at" type="TIMESTAMPTZ"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMPTZ"/>
        </createTable>
        <addUniqueConstraint tableName="voice" columnNames="name" constraintName="uq_voice_name"/>
    </changeSet>
</databaseChangeLog>
